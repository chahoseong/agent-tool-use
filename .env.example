# scripts/evaluate.py: tasks / show / run에 필요한 공식 데이터 디렉토리.
# 실제 tau2-bench의 data 디렉토리 절대 경로로 수정하세요. 기본 경로는 없습니다.
# evaluate.py는 .env를 직접 로드하지 않으므로 실행 전에 셸 환경변수로 설정하세요.
# PowerShell 예: $env:TAU2_DATA_DIR = "C:/path/to/tau2-bench/data"
TAU2_DATA_DIR=C:/path/to/tau2-bench/data

# 평가 서버 인증이 필요한 경우에만 설정하세요.
# evaluation.toml의 agent.api_key_env / user.api_key_env에 이 변수 이름을 지정합니다.
# 모델 ID와 서버 주소는 evaluation.toml에서 설정합니다.
# EVAL_AGENT_API_KEY=
# EVAL_USER_API_KEY=

# scripts/run_mock_task.py에서 사용하는 기존 실행 설정.
TAU2_LLM_BASE_URL=http://127.0.0.1:8080/v1
TAU2_LLM_MODEL=
TAU2_LLM_API_KEY=
